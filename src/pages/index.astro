---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { churchJsonLd, siteConfig } from "../data/site";

const baseUrl = import.meta.env.BASE_URL;
const asset = (path: string) => `${baseUrl}${path.replace(/^\//, "")}`;
---

<BaseLayout title={siteConfig.title} description={siteConfig.description}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(churchJsonLd)} />
  </Fragment>

  <Header />

  <main>
    <section class="hero hero-home">
      <div class="hero-media">
        <img
          src={asset(siteConfig.heroImage)}
          alt="Apostle T.D. Robinson preaching in a maroon robe at the pulpit."
        />
      </div>
      <div class="hero-backdrop"></div>
      <div class="shell hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Welcome To Our Home</p>
          <h1>{siteConfig.name}</h1>
          <p class="lead">{siteConfig.tagline}</p>
          <p class="body-copy">
            Join a ministry rooted in worship, biblical truth, and the belief that every
            person matters in the presence of God.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href={`${baseUrl}watch/`}>Watch Us Live</a>
            <a class="button button-secondary" href={`${baseUrl}contact/`}>Plan Your Visit</a>
          </div>
        </div>

        <aside class="hero-panel">
          <p class="card-kicker">Service Times</p>
          <div class="schedule-stack">
            {
              siteConfig.serviceTimes.map((item) => (
                <article class="schedule-card">
                  <strong>{item.label}</strong>
                  <span>{item.time}</span>
                  <small>{item.detail}</small>
                </article>
              ))
            }
          </div>
          <div class="location-badge">
            <strong>{siteConfig.addressLine1}</strong>
            <span>{siteConfig.cityStateZip}</span>
          </div>
        </aside>
      </div>
    </section>

    <section class="stats shell">
      {
        siteConfig.heroStats.map((item) => (
          <article class="stat-card">
            <strong>{item.value}</strong>
            <span>{item.label}</span>
          </article>
        ))
      }
    </section>

    <section class="section shell">
      <div class="section-heading">
        <p class="eyebrow">First Impression</p>
        <h2>{siteConfig.welcome.title}</h2>
      </div>
      <div class="split-feature">
        <article class="portrait-card">
          <img
            class="portrait-photo"
            src={asset(siteConfig.heroImage)}
            alt="Apostle T.D. Robinson ministering during service."
          />
        </article>
        <div class="feature-copy">
          <p class="body-copy">{siteConfig.welcome.body}</p>
          <blockquote class="highlight-quote">“{siteConfig.welcome.quote}”</blockquote>
          <p class="signature">{siteConfig.welcome.leader}</p>
          <p class="signature-sub">{siteConfig.welcome.role}</p>
        </div>
      </div>
    </section>

    <section class="section band">
      <div class="shell">
        <div class="section-heading">
          <p class="eyebrow">What The Site Needs To Do</p>
          <h2>Show the life of the ministry clearly and quickly.</h2>
        </div>
        <div class="card-grid">
          {
            siteConfig.pillars.map((item) => (
              <article class="content-card">
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section shell">
      <div class="section-heading">
        <p class="eyebrow">Ministries</p>
        <h2>Areas where people can belong, serve, and grow.</h2>
      </div>
      <div class="card-grid">
        {
          siteConfig.ministries.slice(0, 3).map((item) => (
            <article class="content-card">
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </article>
          ))
        }
      </div>
      <div class="section-cta">
        <a class="button button-secondary" href={`${baseUrl}ministries/`}>Explore All Ministries</a>
      </div>
    </section>

    <section class="section shell">
      <div class="section-heading">
        <p class="eyebrow">Watch</p>
        <h2>Make room for live services, clips, and message replays.</h2>
      </div>
      <div class="watch-layout">
        <article class="media-feature">
          <img
            src={asset(siteConfig.heroImage)}
            alt="Apostle T.D. Robinson preaching with congregation visible behind him."
          />
        </article>
        <div class="triple-grid">
        {
          siteConfig.watchCards.map((item) => (
            <article class="action-card">
              <h3>{item.title}</h3>
              <p>{item.description}</p>
              <a href={item.href}>{item.cta}</a>
            </article>
          ))
        }
        </div>
      </div>
    </section>

    <section class="section shell">
      <div class="faq-layout">
        <div class="section-heading">
          <p class="eyebrow">FAQ</p>
          <h2>Helpful answers for first-time visitors and online guests.</h2>
        </div>
        <div class="faq-list">
          {
            siteConfig.faqs.map((item) => (
              <details class="faq-item">
                <summary>{item.question}</summary>
                <p>{item.answer}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section shell">
      <div class="contact-banner">
        <div>
          <p class="eyebrow">Next Steps</p>
          <h2>Come visit, watch online, or reach out for prayer and connection.</h2>
        </div>
        <div class="inline-actions">
          <a class="button button-primary" href={`${baseUrl}contact/`}>Contact The Church</a>
          <a class="button button-secondary" href={`${baseUrl}give/`}>Give Online</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
